# Database connection string used by the Python application.
DATABASE_URL=postgresql://agent:agentpass@localhost:5432/agent_memory

# Embedding provider configuration.
# Warning: embedding dimensions depend on the active provider and model.
# Examples:
# - nomic-embed-text (Ollama) = 768
# - text-embedding-3-small = 1536
# - text-embedding-3-large = 3072
# PostgreSQL VECTOR(N) must match EMBEDDING_DIMENSIONS.
# ANN indexes are enabled for 768 and 1536 dimensions.
# 3072 dimensions are stored and queried with exact search.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

OLLAMA_BASE_URL=http://localhost:11434

# Logging
LOG_LEVEL=INFO

OPENAI_API_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
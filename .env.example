# Database connection string used by the Python application.
DATABASE_URL=postgresql://agent:agentpass@localhost:5432/agent_memory

# Embedding provider configuration.
#
# Supported providers: ollama, openai, azure
# Supported dimensions: 768 (default), 1536
# Experimental: 3072 (exact scan, no ANN index)
#
# Each (provider, model, dimension) combination stores embeddings independently.
# Switching providers adds new embeddings without destroying existing ones.
# Re-run the indexer after changing provider settings.
#
# Examples:
#   Ollama:  nomic-embed-text = 768
#   OpenAI:  text-embedding-3-small = 1536
#   Azure:   text-embedding-3-small = 1536
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

OLLAMA_BASE_URL=http://localhost:11434

# Logging
LOG_LEVEL=INFO

OPENAI_API_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=